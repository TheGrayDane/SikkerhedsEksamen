# ---------------------------------------------------------------------------
# Visual Studio Code
# ---------------------------------------------------------------------------
# Ignore personal settings, but keep shared team config
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix
*.code-workspace
.ionide/

# ---------------------------------------------------------------------------
# JetBrains Rider
# ---------------------------------------------------------------------------
# Ignore the whole .idea folder by default
.idea/
*.iml
*.ipr
*.iws
.idea_modules/
cmake-build-*/
out/

# Rider / ReSharper / dotCover / dotTrace / dotMemory
*.sln.DotSettings.user
*.csproj.DotSettings.user
*.DotSettings.user
_ReSharper.Caches/
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/dataSources/
